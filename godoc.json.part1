eAppEngine when running on Google App Engine. Trust X-Appengine-Remote-Addr\n\t// for determining the client's IP\n\tPlatformGoogleAppEngine = \"X-Appengine-Remote-Addr\"\n\t// PlatformCloudflare when using Cloudflare's CDN. Trust CF-Connecting-IP for determining\n\t// the client's IP\n\tPlatformCloudflare = \"CF-Connecting-IP\"\n\t// PlatformFlyIO when running on Fly.io. Trust Fly-Client-IP for determining the client's IP\n\tPlatformFlyIO = \"Fly-Client-IP\"\n)","position":{"file":"gin.go","line":94}},{"name":"DebugMode","doc":"","declaration":"const (\n\t// DebugMode indicates gin mode is debug.\n\tDebugMode = \"debug\"\n\t// ReleaseMode indicates gin mode is release.\n\tReleaseMode = \"release\"\n\t// TestMode indicates gin mode is test.\n\tTestMode = \"test\"\n)","position":{"file":"mode.go","line":21}},{"name":"ReleaseMode","doc":"","declaration":"const (\n\t// DebugMode indicates gin mode is debug.\n\tDebugMode = \"debug\"\n\t// ReleaseMode indicates gin mode is release.\n\tReleaseMode = \"release\"\n\t// TestMode indicates gin mode is test.\n\tTestMode = \"test\"\n)","position":{"file":"mode.go","line":23}},{"name":"TestMode","doc":"","declaration":"const (\n\t// DebugMode indicates gin mode is debug.\n\tDebugMode = \"debug\"\n\t// ReleaseMode indicates gin mode is release.\n\tReleaseMode = \"release\"\n\t// TestMode indicates gin mode is test.\n\tTestMode = \"test\"\n)","position":{"file":"mode.go","line":25}},{"name":"AuthProxyUserKey","doc":"AuthProxyUserKey is the cookie name for proxy_user credential in basic auth for proxy.","docMarkdown":"AuthProxyUserKey is the cookie name for proxy\\_user credential in basic auth for proxy.","declaration":"const AuthProxyUserKey = \"proxy_user\"","position":{"file":"auth.go","line":20}},{"name":"AuthUserKey","doc":"AuthUserKey is the cookie name for user credential in basic auth.","docMarkdown":"AuthUserKey is the cookie name for user credential in basic auth.","declaration":"const AuthUserKey = \"user\"","position":{"file":"auth.go","line":17}},{"name":"BindKey","doc":"BindKey indicates a default bind key.","docMarkdown":"BindKey indicates a default bind key.","declaration":"const BindKey = \"_gin-gonic/gin/bindkey\"","position":{"file":"utils.go","line":20}},{"name":"BodyBytesKey","doc":"BodyBytesKey indicates a default body bytes key.","docMarkdown":"BodyBytesKey indicates a default body bytes key.","declaration":"const BodyBytesKey = \"_gin-gonic/gin/bodybyteskey\"","position":{"file":"context.go","line":47}},{"name":"ContextKey","doc":"ContextKey is the key that a Context returns itself for.","docMarkdown":"ContextKey is the key that a Context returns itself for.","declaration":"const ContextKey = \"_gin-gonic/gin/contextkey\"","position":{"file":"context.go","line":50}},{"name":"EnvGinMode","doc":"EnvGinMode indicates environment name for gin mode.","docMarkdown":"EnvGinMode indicates environment name for gin mode.","declaration":"const EnvGinMode = \"GIN_MODE\"","position":{"file":"mode.go","line":17}},{"name":"MethodQuery","doc":"MethodQuery is the HTTP QUERY method defined by RFC 10008. It is declared\nhere because the standard library does not provide http.MethodQuery yet.\nOnce it does, this constant keeps the same value and stays valid.","docMarkdown":"MethodQuery is the HTTP QUERY method defined by RFC 10008. It is declared here because the standard library does not provide http.MethodQuery yet. Once it does, this constant keeps the same value and stays valid.","declaration":"const MethodQuery = \"QUERY\"","position":{"file":"routergroup.go","line":17}},{"name":"Version","doc":"Version is the current gin framework's version.","docMarkdown":"Version is the current gin framework's version.","declaration":"const Version = \"v1.12.0\"","position":{"file":"version.go","line":8}},{"name":"ContextRequestKey","doc":"","declaration":"const ContextRequestKey ContextKeyType = 0","position":{"file":"context.go","line":54}},{"name":"ErrorTypeBind","doc":"","declaration":"const (\n\t// ErrorTypeBind is used when Context.Bind() fails.\n\tErrorTypeBind ErrorType = 1 << 63\n\t// ErrorTypeRender is used when Context.Render() fails.\n\tErrorTypeRender ErrorType = 1 << 62\n\t// ErrorTypePrivate indicates a private error.\n\tErrorTypePrivate ErrorType = 1 << 0\n\t// ErrorTypePublic indicates a public error.\n\tErrorTypePublic ErrorType = 1 << 1\n\t// ErrorTypeAny indicates any other error.\n\tErrorTypeAny ErrorType = 1<<64 - 1\n)","position":{"file":"errors.go","line":20}},{"name":"ErrorTypeRender","doc":"","declaration":"const (\n\t// ErrorTypeBind is used when Context.Bind() fails.\n\tErrorTypeBind ErrorType = 1 << 63\n\t// ErrorTypeRender is used when Context.Render() fails.\n\tErrorTypeRender ErrorType = 1 << 62\n\t// ErrorTypePrivate indicates a private error.\n\tErrorTypePrivate ErrorType = 1 << 0\n\t// ErrorTypePublic indicates a public error.\n\tErrorTypePublic ErrorType = 1 << 1\n\t// ErrorTypeAny indicates any other error.\n\tErrorTypeAny ErrorType = 1<<64 - 1\n)","position":{"file":"errors.go","line":22}},{"name":"ErrorTypePrivate","doc":"","declaration":"const (\n\t// ErrorTypeBind is used when Context.Bind() fails.\n\tErrorTypeBind ErrorType = 1 << 63\n\t// ErrorTypeRender is used when Context.Render() fails.\n\tErrorTypeRender ErrorType = 1 << 62\n\t// ErrorTypePrivate indicates a private error.\n\tErrorTypePrivate ErrorType = 1 << 0\n\t// ErrorTypePublic indicates a public error.\n\tErrorTypePublic ErrorType = 1 << 1\n\t// ErrorTypeAny indicates any other error.\n\tErrorTypeAny ErrorType = 1<<64 - 1\n)","position":{"file":"errors.go","line":24}},{"name":"ErrorTypePublic","doc":"","declaration":"const (\n\t// ErrorTypeBind is used when Context.Bind() fails.\n\tErrorTypeBind ErrorType = 1 << 63\n\t// ErrorTypeRender is used when Context.Render() fails.\n\tErrorTypeRender ErrorType = 1 << 62\n\t// ErrorTypePrivate indicates a private error.\n\tErrorTypePrivate ErrorType = 1 << 0\n\t// ErrorTypePublic indicates a public error.\n\tErrorTypePublic ErrorType = 1 << 1\n\t// ErrorTypeAny indicates any other error.\n\tErrorTypeAny ErrorType = 1<<64 - 1\n)","position":{"file":"errors.go","line":26}},{"name":"ErrorTypeAny","doc":"","declaration":"const (\n\t// ErrorTypeBind is used when Context.Bind() fails.\n\tErrorTypeBind ErrorType = 1 << 63\n\t// ErrorTypeRender is used when Context.Render() fails.\n\tErrorTypeRender ErrorType = 1 << 62\n\t// ErrorTypePrivate indicates a private error.\n\tErrorTypePrivate ErrorType = 1 << 0\n\t// ErrorTypePublic indicates a public error.\n\tErrorTypePublic ErrorType = 1 << 1\n\t// ErrorTypeAny indicates any other error.\n\tErrorTypeAny ErrorType = 1<<64 - 1\n)","position":{"file":"errors.go","line":28}}],"vars":[{"name":"DebugPrintFunc","doc":"DebugPrintFunc indicates debug log output format.","docMarkdown":"DebugPrintFunc indicates debug log output format.","declaration":"var DebugPrintFunc func(format string, values ...any)","position":{"file":"debug.go","line":30}},{"name":"DebugPrintRouteFunc","doc":"DebugPrintRouteFunc indicates debug log output format.","docMarkdown":"DebugPrintRouteFunc indicates debug log output format.","declaration":"var DebugPrintRouteFunc func(httpMethod, absolutePath, handlerName string, nuHandlers int)","position":{"file":"debug.go","line":27}},{"name":"DefaultErrorWriter","doc":"DefaultErrorWriter is the default io.Writer used by Gin to debug errors","docMarkdown":"DefaultErrorWriter is the default io.Writer used by Gin to debug errors","declaration":"var DefaultErrorWriter io.Writer = os.Stderr","position":{"file":"mode.go","line":45}},{"name":"DefaultWriter","doc":"DefaultWriter is the default io.Writer used by Gin for debug output and\nmiddleware output like Logger() or Recovery().\nNote that both Logger and Recovery provides custom ways to configure their\noutput io.Writer.\nTo support coloring in Windows use:\n\n\timport \"github.com/mattn/go-colorable\"\n\tgin.DefaultWriter = colorable.NewColorableStdout()","docMarkdown":"DefaultWriter is the default io.Writer used by Gin for debug output and middleware output like Logger() or Recovery(). Note that both Logger and Recovery provides custom ways to configure their output io.Writer. To support coloring in Windows use:\n\n\timport \"github.com/mattn/go-colorable\"\n\tgin.DefaultWriter = colorable.NewColorableStdout()","declaration":"var DefaultWriter io.Writer = os.Stdout","position":{"file":"mode.go","line":42}}],"funcs":[{"name":"BasicAuth","doc":"BasicAuth returns a Basic HTTP Authorization middleware. It takes as argument a map[string]string where\nthe key is the user name and the value is the password.","docMarkdown":"BasicAuth returns a Basic HTTP Authorization middleware. It takes as argument a map\\[string]string where the key is the user name and the value is the password.","signature":"func BasicAuth(accounts Accounts) HandlerFunc","position":{"file":"auth.go","line":72},"examples":[]},{"name":"BasicAuthForProxy","doc":"BasicAuthForProxy returns a Basic HTTP Proxy-Authorization middleware.\nIf the realm is empty, \"Proxy Authorization Required\" will be used by default.","docMarkdown":"BasicAuthForProxy returns a Basic HTTP Proxy-Authorization middleware. If the realm is empty, \"Proxy Authorization Required\" will be used by default.","signature":"func BasicAuthForProxy(accounts Accounts, realm string) HandlerFunc","position":{"file":"auth.go","line":98},"examples":[]},{"name":"BasicAuthForRealm","doc":"BasicAuthForRealm returns a Basic HTTP Authorization middleware. It takes as arguments a map[string]string where\nthe key is the user name and the value is the password, as well as the name of the Realm.\nIf the realm is empty, \"Authorization Required\" will be used by default.\n(see http://tools.ietf.org/html/rfc2617#section-1.2)","docMarkdown":"BasicAuthForRealm returns a Basic HTTP Authorization middleware. It takes as arguments a map\\[string]string where the key is the user name and the value is the password, as well as the name of the Realm. If the realm is empty, \"Authorization Required\" will be used by default. (see [http://tools.ietf.org/html/rfc2617#section-1.2](http://tools.ietf.org/html/rfc2617#section-1.2))","signature":"func BasicAuthForRealm(accounts Accounts, realm string) HandlerFunc","position":{"file":"auth.go","line":48},"examples":[]},{"name":"Bind","doc":"Bind is a helper function for given interface object and returns a Gin middleware.\nIt panics if val is a pointer; pass the struct value directly (e.g., gin.Bind(Struct{}) not gin.Bind(&Struct{})).","docMarkdown":"Bind is a helper function for given interface object and returns a Gin middleware. It panics if val is a pointer; pass the struct value directly (e.g., gin.Bind(Struct{}) not gin.Bind(&Struct{})).","signature":"func Bind(val any) HandlerFunc","position":{"file":"utils.go","line":30},"examples":[]},{"name":"CreateTestContext","doc":"CreateTestContext returns a fresh Engine and a Context associated with it.\nThis is useful for tests that need to set up a new Gin engine instance\nalong with a context, for example, to test middleware that doesn't depend on\nspecific routes. The ResponseWriter `w` is used to initialize the context's writer.","docMarkdown":"CreateTestContext returns a fresh Engine and a Context associated with it. This is useful for tests that need to set up a new Gin engine instance along with a context, for example, to test middleware that doesn't depend on specific routes. The ResponseWriter `w` is used to initialize the context's writer.","signature":"func CreateTestContext(w http.ResponseWriter) (c *Context, r *Engine)","position":{"file":"test_helpers.go","line":17},"examples":[]},{"name":"CreateTestContextOnly","doc":"CreateTestContextOnly returns a fresh Context associated with the provided Engine `r`.\nThis is useful for tests that operate on an existing, possibly pre-configured,\nGin engine instance and need a new context for it.\nThe ResponseWriter `w` is used to initialize the context's writer.\nThe context is allocated with the `maxParams` setting from the provided engine.","docMarkdown":"CreateTestContextOnly returns a fresh Context associated with the provided Engine `r`. This is useful for tests that operate on an existing, possibly pre-configured, Gin engine instance and need a new context for it. The ResponseWriter `w` is used to initialize the context's writer. The context is allocated with the `maxParams` setting from the provided engine.","signature":"func CreateTestContextOnly(w http.ResponseWriter, r *Engine) (c *Context)","position":{"file":"test_helpers.go","line":30},"examples":[]},{"name":"CustomRecovery","doc":"CustomRecovery returns a middleware that recovers from any panics and calls the provided handle func to handle it.","docMarkdown":"CustomRecovery returns a middleware that recovers from any panics and calls the provided handle func to handle it.","signature":"func CustomRecovery(handle RecoveryFunc) HandlerFunc","position":{"file":"recovery.go","line":40},"examples":[]},{"name":"CustomRecoveryWithWriter","doc":"CustomRecoveryWithWriter returns a middleware for a given writer that recovers from any panics and calls the provided handle func to handle it.","docMarkdown":"CustomRecoveryWithWriter returns a middleware for a given writer that recovers from any panics and calls the provided handle func to handle it.","signature":"func CustomRecoveryWithWriter(out io.Writer, handle RecoveryFunc) HandlerFunc","position":{"file":"recovery.go","line":53},"examples":[]},{"name":"Default","doc":"Default returns an Engine instance with the Logger and Recovery middleware already attached.","docMarkdown":"Default returns an Engine instance with the Logger and Recovery middleware already attached.","signature":"func Default(opts ...OptionFunc) *Engine","position":{"file":"gin.go","line":250},"examples":[]},{"name":"Dir","doc":"Dir returns an http.FileSystem that can be used by http.FileServer().\nIt is used internally in router.Static().\nif listDirectory == true, then it works the same as http.Dir(),\notherwise it returns a filesystem that prevents http.FileServer() to list the directory files.","docMarkdown":"Dir returns an http.FileSystem that can be used by http.FileServer(). It is used internally in router.Static(). if listDirectory == true, then it works the same as http.Dir(), otherwise it returns a filesystem that prevents http.FileServer() to list the directory files.","signature":"func Dir(root string, listDirectory bool) http.FileSystem","position":{"file":"fs.go","line":42},"examples":[]},{"name":"DisableBindValidation","doc":"DisableBindValidation closes the default validator.","docMarkdown":"DisableBindValidation closes the default validator.","signature":"func DisableBindValidation()","position":{"file":"mode.go","line":81},"examples":[]},{"name":"DisableConsoleColor","doc":"DisableConsoleColor disables color output in the console.","docMarkdown":"DisableConsoleColor disables color output in the console.","signature":"func DisableConsoleColor()","position":{"file":"logger.go","line":197},"examples":[]},{"name":"EnableJsonDecoderDisallowUnknownFields","doc":"EnableJsonDecoderDisallowUnknownFields sets true for binding.EnableDecoderDisallowUnknownFields to\ncall the DisallowUnknownFields method on the JSON Decoder instance.","docMarkdown":"EnableJsonDecoderDisallowUnknownFields sets true for binding.EnableDecoderDisallowUnknownFields to call the DisallowUnknownFields method on the JSON Decoder instance.","signature":"func EnableJsonDecoderDisallowUnknownFields()","position":{"file":"mode.go","line":93},"examples":[]},{"name":"EnableJsonDecoderUseNumber","doc":"EnableJsonDecoderUseNumber sets true for binding.EnableDecoderUseNumber to\ncall the UseNumber method on the JSON Decoder instance.","docMarkdown":"EnableJsonDecoderUseNumber sets true for binding.EnableDecoderUseNumber to call the UseNumber method on the JSON Decoder instance.","signature":"func EnableJsonDecoderUseNumber()","position":{"file":"mode.go","line":87},"examples":[]},{"name":"ErrorLogger","doc":"ErrorLogger returns a HandlerFunc for any error type.","docMarkdown":"ErrorLogger returns a HandlerFunc for any error type.","signature":"func ErrorLogger() HandlerFunc","position":{"file":"logger.go","line":207},"examples":[]},{"name":"ErrorLoggerT","doc":"ErrorLoggerT returns a HandlerFunc for a given error type.","docMarkdown":"ErrorLoggerT returns a HandlerFunc for a given error type.","signature":"func ErrorLoggerT(typ ErrorType) HandlerFunc","position":{"file":"logger.go","line":212},"examples":[]},{"name":"ForceConsoleColor","doc":"ForceConsoleColor force color output in the console.","docMarkdown":"ForceConsoleColor force color output in the console.","signature":"func ForceConsoleColor()","position":{"file":"logger.go","line":202},"examples":[]},{"name":"IsDebugging","doc":"IsDebugging returns true if the framework is running in debug mode.\nUse SetMode(gin.ReleaseMode) to disable debug mode.","docMarkdown":"IsDebugging returns true if the framework is running in debug mode. Use SetMode(gin.ReleaseMode) to disable debug mode.","signature":"func IsDebugging() bool","position":{"file":"debug.go","line":22},"examples":[]},{"name":"Logger","doc":"Logger instances a Logger middleware that will write the logs to gin.DefaultWriter.\nBy default, gin.DefaultWriter = os.Stdout.","docMarkdown":"Logger instances a Logger middleware that will write the logs to gin.DefaultWriter. By default, gin.DefaultWriter = os.Stdout.","signature":"func Logger() HandlerFunc","position":{"file":"logger.go","line":224},"examples":[]},{"name":"LoggerWithConfig","doc":"LoggerWithConfig instance a Logger middleware with config.","docMarkdown":"LoggerWithConfig instance a Logger middleware with config.","signature":"func LoggerWithConfig(conf LoggerConfig) HandlerFunc","position":{"file":"logger.go","line":245},"examples":[]},{"name":"LoggerWithFormatter","doc":"LoggerWithFormatter instance a Logger middleware with the specified log format function.","docMarkdown":"LoggerWithFormatter instance a Logger middleware with the specified log format function.","signature":"func LoggerWithFormatter(f LogFormatter) HandlerFunc","position":{"file":"logger.go","line":229},"examples":[]},{"name":"LoggerWithWriter","doc":"LoggerWithWriter instance a Logger middleware with the specified writer buffer.\nExample: os.Stdout, a file opened in write mode, a socket...","docMarkdown":"LoggerWithWriter instance a Logger middleware with the specified writer buffer. Example: os.Stdout, a file opened in write mode, a socket...","signature":"func LoggerWithWriter(out io.Writer, notlogged ...string) HandlerFunc","position":{"file":"logger.go","line":237},"examples":[]},{"name":"Mode","doc":"Mode returns current gin mode.","docMarkdown":"Mode returns current gin mode.","signature":"func Mode() string","position":{"file":"mode.go","line":98},"examples":[]},{"name":"New","doc":"New returns a new blank Engine instance without any middleware attached.\nBy default, the configuration is:\n- RedirectTrailingSlash:  true\n- RedirectFixedPath:      false\n- HandleMethodNotAllowed: false\n- ForwardedByClientIP:    true\n- UseRawPath:             false\n- UseEscapedPath: \t\t false\n- UnescapePathValues:     true","docMarkdown":"New returns a new blank Engine instance without any middleware attached. By default, the configuration is: - RedirectTrailingSlash:  true - RedirectFixedPath:      false - HandleMethodNotAllowed: false - ForwardedByClientIP:    true - UseRawPath:             false - UseEscapedPath: \t\t false - UnescapePathValues:     true","signature":"func New(opts ...OptionFunc) *Engine","position":{"file":"gin.go","line":215},"examples":[]},{"name":"Recovery","doc":"Recovery returns a middleware that recovers from any panics and writes a 500 if there was one.","docMarkdown":"Recovery returns a middleware that recovers from any panics and writes a 500 if there was one.","signature":"func Recovery() HandlerFunc","position":{"file":"recovery.go","line":35},"examples":[]},{"name":"RecoveryWithWriter","doc":"RecoveryWithWriter returns a middleware for a given writer that recovers from any panics and writes a 500 if there was one.","docMarkdown":"RecoveryWithWriter returns a middleware for a given writer that recovers from any panics and writes a 500 if there was one.","signature":"func RecoveryWithWriter(out io.Writer, recovery ...RecoveryFunc) HandlerFunc","position":{"file":"recovery.go","line":45},"examples":[]},{"name":"SetMode","doc":"SetMode sets gin mode according to input string.","docMarkdown":"SetMode sets gin mode according to input string.","signature":"func SetMode(value string)","position":{"file":"mode.go","line":58},"examples":[]},{"name":"WrapF","doc":"WrapF is a helper function for wrapping http.HandlerFunc and returns a Gin middleware.","docMarkdown":"WrapF is a helper function for wrapping http.HandlerFunc and returns a Gin middleware.","signature":"func WrapF(f http.HandlerFunc) HandlerFunc","position":{"file":"utils.go","line":48},"examples":[]},{"name":"WrapH","doc":"WrapH is a helper function for wrapping http.Handler and returns a Gin middleware.","docMarkdown":"WrapH is a helper function for wrapping http.Handler and returns a Gin middleware.","signature":"func WrapH(h http.Handler) HandlerFunc","position":{"file":"utils.go","line":55},"examples":[]}],"types":[{"name":"Accounts","doc":"Accounts defines a key/value for user/pass list of authorized logins.","docMarkdown":"Accounts defines a key/value for user/pass list of authorized logins.","declaration":"type Accounts map[string]string","kind":"defined","position":{"file":"auth.go","line":23},"fields":[],"methods":[],"examples":[]},{"name":"Context","doc":"Context is the most important part of gin. It allows us to pass variables between middleware,\nmanage the flow, validate the JSON of a request and render a JSON response for example.","docMarkdown":"Context is the most important part of gin. It allows us to pass variables between middleware, manage the flow, validate the JSON of a request and render a JSON response for example.","declaration":"type Context struct {\n\tRequest *http.Request\n\tWriter  ResponseWriter\n\n\tParams Params\n\n\t// Keys is a key/value pair exclusively for the context of each request.\n\tKeys map[any]any\n\n\t// Errors is a list of errors attached to all the handlers/middlewares who used this context.\n\tErrors errorMsgs\n\n\t// Accepted defines a list of manually accepted formats for content negotiation.\n\tAccepted []string\n\t// contains filtered or unexported fields\n}","kind":"struct","position":{"file":"context.go","line":61},"fields":[{"name":"Request","doc":"","type":"*http.Request"},{"name":"Writer","doc":"","type":"ResponseWriter"},{"name":"Params","doc":"","type":"Params"},{"name":"Keys","doc":"Keys is a key/value pair exclusively for the context of each request.","docMarkdown":"Keys is a key/value pair exclusively for the context of each request.","type":"map[any]any"},{"name":"Errors","doc":"Errors is a list of errors attached to all the handlers/middlewares who used this context.","docMarkdown":"Errors is a list of errors attached to all the handlers/middlewares who used this context.","type":"errorMsgs"},{"name":"Accepted","doc":"Accepted defines a list of manually accepted formats for content negotiation.","docMarkdown":"Accepted defines a list of manually accepted formats for content negotiation.","type":"[]string"}],"methods":[{"name":"Abort","doc":"Abort prevents pending handlers from being called. Note that this will not stop the current handler.\nLet's say you have an authorization middleware that validates that the current request is authorized.\nIf the authorization fails (ex: the password does not match), call Abort to ensure the remaining handlers\nfor this request are not called.","docMarkdown":"Abort prevents pending handlers from being called. Note that this will not stop the current handler. Let's say you have an authorization middleware that validates that the current request is authorized. If the authorization fails (ex: the password does not match), call Abort to ensure the remaining handlers for this request are not called.","signature":"func (c *Context) Abort()","position":{"file":"context.go","line":216},"examples":[]},{"name":"AbortWithError","doc":"AbortWithError calls `AbortWithStatus()` and `Error()` internally.\nThis method stops the chain, writes the status code and pushes the specified error to `c.Errors`.\nSee Context.Error() for more details.","docMarkdown":"AbortWithError calls `AbortWithStatus()` and `Error()` internally. This method stops the chain, writes the status code and pushes the specified error to `c.Errors`. See Context.Error() for more details.","signature":"func (c *Context) AbortWithError(code int, err error) *Error","position":{"file":"context.go","line":247},"examples":[]},{"name":"AbortWithStatus","doc":"AbortWithStatus calls `Abort()` and writes the headers with the specified status code.\nFor example, a failed attempt to authenticate a request could use: context.AbortWithStatus(401).","docMarkdown":"AbortWithStatus calls `Abort()` and writes the headers with the specified status code. For example, a failed attempt to authenticate a request could use: context.AbortWithStatus(401).","signature":"func (c *Context) AbortWithStatus(code int)","position":{"file":"context.go","line":222},"examples":[]},{"name":"AbortWithStatusJSON","doc":"AbortWithStatusJSON calls `Abort()` and then `JSON` internally.\nThis method stops the chain, writes the status code and return a JSON body.\nIt also sets the Content-Type as \"application/json\".","docMarkdown":"AbortWithStatusJSON calls `Abort()` and then `JSON` internally. This method stops the chain, writes the status code and return a JSON body. It also sets the Content-Type as \"application/json\".","signature":"func (c *Context) AbortWithStatusJSON(code int, jsonObj any)","position":{"file":"context.go","line":239},"examples":[]},{"name":"AbortWithStatusPureJSON","doc":"AbortWithStatusPureJSON calls `Abort()` and then `PureJSON` internally.\nThis method stops the chain, writes the status code and return a JSON body without escaping.\nIt also sets the Content-Type as \"application/json\".","docMarkdown":"AbortWithStatusPureJSON calls `Abort()` and then `PureJSON` internally. This method stops the chain, writes the status code and return a JSON body without escaping. It also sets the Content-Type as \"application/json\".","signature":"func (c *Context) AbortWithStatusPureJSON(code int, jsonObj any)","position":{"file":"context.go","line":231},"examples":[]},{"name":"AddParam","doc":"AddParam adds param to context and\nreplaces path param key with given value for e2e testing purposes\nExample Route: \"/user/:id\"\nAddParam(\"id\", 1)\nResult: \"/user/1\"","docMarkdown":"AddParam adds param to context and replaces path param key with given value for e2e testing purposes Example Route: \"/user/:id\" AddParam(\"id\", 1) Result: \"/user/1\"","signature":"func (c *Context) AddParam(key, value string)","position":{"file":"context.go","line":521},"examples":[]},{"name":"AsciiJSON","doc":"AsciiJSON serializes the given struct as JSON into the response body with unicode to ASCII string.\nIt also sets the Content-Type as \"application/json\".","docMarkdown":"AsciiJSON serializes the given struct as JSON into the response body with unicode to ASCII string. It also sets the Content-Type as \"application/json\".","signature":"func (c *Context) AsciiJSON(code int, obj any)","position":{"file":"context.go","line":1265},"examples":[]},{"name":"BSON","doc":"BSON serializes the given struct as BSON into the response body.","docMarkdown":"BSON serializes the given struct as BSON into the response body.","signature":"func (c *Context) BSON(code int, obj any)","position":{"file":"context.go","line":1303},"examples":[]},{"name":"Bind","doc":"Bind checks the Method and Content-Type to select a binding engine automatically,\nDepending on the \"Content-Type\" header different bindings are used, for example:\n\n\t\"application/json\" --> JSON binding\n\t\"application/xml\"  --> XML binding\n\nIt parses the request's body based on the Content-Type (e.g., JSON or XML).\nIt decodes the payload into the struct specified as a pointer.\nIt writes a 400 error and sets Content-Type header \"text/plain\" in the response if input is not valid.","docMarkdown":"Bind checks the Method and Content-Type to select a binding engine automatically, Depending on the \"Content-Type\" header different bindings are used, for example:\n\n\t\"application/json\" --> JSON binding\n\t\"application/xml\"  --> XML binding\n\nIt parses the request's body based on the Content-Type (e.g., JSON or XML). It decodes the payload into the struct specified as a pointer. It writes a 400 error and sets Content-Type header \"text/plain\" in the response if input is not valid.","signature":"func (c *Context) Bind(obj any) error","position":{"file":"context.go","line":779},"examples":[]},{"name":"BindHeader","doc":"BindHeader is a shortcut for c.MustBindWith(obj, binding.Header).","docMarkdown":"BindHeader is a shortcut for c.MustBindWith(obj, binding.Header).","signature":"func (c *Context) BindHeader(obj any) error","position":{"file":"context.go","line":815},"examples":[]},{"name":"BindJSON","doc":"BindJSON is a shortcut for c.MustBindWith(obj, binding.JSON).","docMarkdown":"BindJSON is a shortcut for c.MustBindWith(obj, binding.JSON).","signature":"func (c *Context) BindJSON(obj any) error","position":{"file":"context.go","line":785},"examples":[]},{"name":"BindPlain","doc":"BindPlain is a shortcut for c.MustBindWith(obj, binding.Plain).","docMarkdown":"BindPlain is a shortcut for c.MustBindWith(obj, binding.Plain).","signature":"func (c *Context) BindPlain(obj any) error","position":{"file":"context.go","line":810},"examples":[]},{"name":"BindQuery","doc":"BindQuery is a shortcut for c.MustBindWith(obj, binding.Query).","docMarkdown":"BindQuery is a shortcut for c.MustBindWith(obj, binding.Query).","signature":"func (c *Context) BindQuery(obj any) error","position":{"file":"context.go","line":795},"examples":[]},{"name":"BindTOML","doc":"BindTOML is a shortcut for c.MustBindWith(obj, binding.TOML).","docMarkdown":"BindTOML is a shortcut for c.MustBindWith(obj, binding.TOML).","signature":"func (c *Context) BindTOML(obj any) error","position":{"file":"context.go","line":805},"examples":[]},{"name":"BindUri","doc":"BindUri binds the passed struct pointer using binding.Uri.\nIt will abort the request with HTTP 400 if any error occurs.","docMarkdown":"BindUri binds the passed struct pointer using binding.Uri. It will abort the request with HTTP 400 if any error occurs.","signature":"func (c *Context) BindUri(obj any) error","position":{"file":"context.go","line":821},"examples":[]},{"name":"BindWith","doc":"BindWith binds the passed struct pointer using the specified binding engine.\nSee the binding package.\n\nDeprecated: Use MustBindWith or ShouldBindWith.","docMarkdown":"BindWith binds the passed struct pointer using the specified binding engine. See the binding package.\n\nDeprecated: Use MustBindWith or ShouldBindWith.","signature":"func (c *Context) BindWith(obj any, b binding.Binding) error","position":{"file":"deprecated.go","line":17},"examples":[]},{"name":"BindXML","doc":"BindXML is a shortcut for c.MustBindWith(obj, binding.XML).","docMarkdown":"BindXML is a shortcut for c.MustBindWith(obj, binding.XML).","signature":"func (c *Context) BindXML(obj any) error","position":{"file":"context.go","line":790},"examples":[]},{"name":"BindYAML","doc":"BindYAML is a shortcut for c.MustBindWith(obj, binding.YAML).","docMarkdown":"BindYAML is a shortcut for c.MustBindWith(obj, binding.YAML).","signature":"func (c *Context) BindYAML(obj any) error","position":{"file":"context.go","line":800},"examples":[]},{"name":"ClientIP","doc":"ClientIP implements one best effort algorithm to return the real client IP.\nIt calls c.RemoteIP() under the hood, to check if the remote IP is a trusted proxy or not.\nIf it is it will then try to parse the headers defined in Engine.RemoteIPHeaders (defaulting to [X-Forwarded-For, X-Real-IP]).\nIf the headers are not syntactically valid OR the remote IP does not correspond to a trusted proxy,\nthe remote IP (coming from Request.RemoteAddr) is returned.","docMarkdown":"ClientIP implements one best effort algorithm to return the real client IP. It calls c.RemoteIP() under the hood, to check if the remote IP is a trusted proxy or not. If it is it will then try to parse the headers defined in Engine.RemoteIPHeaders (defaulting to \\[X-Forwarded-For, X-Real-IP]). If the headers are not syntactically valid OR the remote IP does not correspond to a trusted proxy, the remote IP (coming from Request.RemoteAddr) is returned.","signature":"func (c *Context) ClientIP() string","position":{"file":"context.go","line":997},"examples":[]},{"name":"ContentType","doc":"ContentType returns the Content-Type header of the request.","docMarkdown":"ContentType returns the Content-Type header of the request.","signature":"func (c *Context) ContentType() string","position":{"file":"context.go","line":1058},"examples":[]},{"name":"Cookie","doc":"Cookie returns the named cookie provided in the request or\nErrNoCookie if not found. And return the named cookie is unescaped.\nIf multiple cookies match the given name, only one cookie will\nbe returned.","docMarkdown":"Cookie returns the named cookie provided in the request or ErrNoCookie if not found. And return the named cookie is unescaped. If multiple cookies match the given name, only one cookie will be returned.","signature":"func (c *Context) Cookie(name string) (string, error)","position":{"file":"context.go","line":1191},"examples":[]},{"name":"Copy","doc":"Copy returns a copy of the current context that can be safely used outside the request's scope.\nThis has to be used when the context has to be passed to a goroutine.","docMarkdown":"Copy returns a copy of the current context that can be safely used outside the request's scope. This has to be used when the context has to be passed to a goroutine.","signature":"func (c *Context) Copy() *Context","position":{"file":"context.go","line":122},"examples":[]},{"name":"Data","doc":"Data writes some data into the body stream and updates the HTTP code.","docMarkdown":"Data writes some data into the body stream and updates the HTTP code.","signature":"func (c *Context) Data(code int, contentType string, data []byte)","position":{"file":"context.go","line":1322},"examples":[]},{"name":"DataFromReader","doc":"DataFromReader writes the specified reader into the body stream and updates the HTTP code.","docMarkdown":"DataFromReader writes the specified reader into the body stream and updates the HTTP code.","signature":"func (c *Context) DataFromReader(code int, contentLength int64, contentType string, reader io.Reader, extraHeaders map[string]string)","position":{"file":"context.go","line":1330},"examples":[]},{"name":"Deadline","doc":"Deadline returns that there is no deadline (ok==false) when c.Request has no Context.","docMarkdown":"Deadline returns that there is no deadline (ok==false) when c.Request has no Context.","signature":"func (c *Context) Deadline() (deadline time.Time, ok bool)","position":{"file":"context.go","line":1501},"examples":[]},{"name":"DefaultPostForm","doc":"DefaultPostForm returns the specified key from a POST urlencoded form or multipart form\nwhen it exists, otherwise it returns the specified defaultValue string.\nSee: PostForm() and GetPostForm() for further information.","docMarkdown":"DefaultPostForm returns the specified key from a POST urlencoded form or multipart form when it exists, otherwise it returns the specified defaultValue string. See: PostForm() and GetPostForm() for further information.","signature":"func (c *Context) DefaultPostForm(key, defaultValue string) string","position":{"file":"context.go","line":618},"examples":[]},{"name":"DefaultQuery","doc":"DefaultQuery returns the keyed url query value if it exists,\notherwise it returns the specified defaultValue string.\nSee: Query() and GetQuery() for further information.\n\n\tGET /?name=Manu&lastname=\n\tc.DefaultQuery(\"name\", \"unknown\") == \"Manu\"\n\tc.DefaultQuery(\"id\", \"none\") == \"none\"\n\tc.DefaultQuery(\"lastname\", \"none\") == \"\"","docMarkdown":"DefaultQuery returns the keyed url query value if it exists, otherwise it returns the specified defaultValue string. See: Query() and GetQuery() for further information.\n\n\tGET /?name=Manu&lastname=\n\tc.DefaultQuery(\"name\", \"unknown\") == \"Manu\"\n\tc.DefaultQuery(\"id\", \"none\") == \"none\"\n\tc.DefaultQuery(\"lastname\", \"none\") == \"\"","signature":"func (c *Context) DefaultQuery(key, defaultValue string) string","position":{"file":"context.go","line":547},"examples":[]},{"name":"Delete","doc":"Delete deletes the key from the Context's Key map, if it exists.\nThis operation is safe to be used by concurrent go-routines","docMarkdown":"Delete deletes the key from the Context's Key map, if it exists. This operation is safe to be used by concurrent go-routines","signature":"func (c *Context) Delete(key any)","position":{"file":"context.go","line":491},"examples":[]},{"name":"Done","doc":"Done returns nil (chan which will wait forever) when c.Request has no Context.","docMarkdown":"Done returns nil (chan which will wait forever) when c.Request has no Context.","signature":"func (c *Context) Done() <-chan struct{}","position":{"file":"context.go","line":1509},"examples":[]},{"name":"Err","doc":"Err returns nil when c.Request has no Context.","docMarkdown":"Err returns nil when c.Request has no Context.","signature":"func (c *Context) Err() error","position":{"file":"context.go","line":1517},"examples":[]},{"name":"Error","doc":"Error attaches an error to the current context. The error is pushed to a list of errors.\nIt's a good idea to call Error for each error that occurred during the resolution of a request.\nA middleware can be used to collect all the errors and push them to a database together,\nprint a log, or append it in the HTTP response.\nError will panic if err is nil.","docMarkdown":"Error attaches an error to the current context. The error is pushed to a list of errors. It's a good idea to call Error for each error that occurred during the resolution of a request. A middleware can be used to collect all the errors and push them to a database together, print a log, or append it in the HTTP response. Error will panic if err is nil.","signature":"func (c *Context) Error(err error) *Error","position":{"file":"context.go","line":261},"examples":[]},{"name":"File","doc":"File writes the specified file into the body stream in an efficient way.","docMarkdown":"File writes the specified file into the body stream in an efficient way.","signature":"func (c *Context) File(filepath string)","position":{"file":"context.go","line":1340},"examples":[]},{"name":"FileAttachment","doc":"FileAttachment writes the specified file into the body stream in an efficient way\nOn the client side, the file will typically be downloaded with the given filename","docMarkdown":"FileAttachment writes the specified file into the body stream in an efficient way On the client side, the file will typically be downloaded with the given filename","signature":"func (c *Context) FileAttachment(filepath, filename string)","position":{"file":"context.go","line":1363},"examples":[]},{"name":"FileFromFS","doc":"FileFromFS writes the specified file from http.FileSystem into the body stream in an efficient way.","docMarkdown":"FileFromFS writes the specified file from http.FileSystem into the body stream in an efficient way.","signature":"func (c *Context) FileFromFS(filepath string, fs http.FileSystem)","position":{"file":"context.go","line":1345},"examples":[]},{"name":"FormFile","doc":"FormFile returns the first file for the provided form key.","docMarkdown":"FormFile returns the first file for the provided form key.","signature":"func (c *Context) FormFile(name string) (*multipart.FileHeader, error)","position":{"file":"context.go","line":707},"examples":[]},{"name":"FullPath","doc":"FullPath returns a matched route full path. For not found routes\nreturns an empty string.\n\n\trouter.GET(\"/user/:id\", func(c *gin.Context) {\n\t    c.FullPath() == \"/user/:id\" // true\n\t})","docMarkdown":"FullPath returns a matched route full path. For not found routes returns an empty string.\n\n\trouter.GET(\"/user/:id\", func(c *gin.Context) {\n\t    c.FullPath() == \"/user/:id\" // true\n\t})","signature":"func (c *Context) FullPath() string","position":{"file":"context.go","line":186},"examples":[]},{"name":"Get","doc":"Get returns the value for the given key, ie: (value, true).\nIf the value does not exist it returns (nil, false)","docMarkdown":"Get returns the value for the given key, ie: (value, true). If the value does not exist it returns (nil, false)","signature":"func (c *Context) Get(key any) (value any, exists bool)","position":{"file":"context.go","line":297},"examples":[]},{"name":"GetBool","doc":"GetBool returns the value associated with the key as a boolean.","docMarkdown":"GetBool returns the value associated with the key as a boolean.","signature":"func (c *Context) GetBool(key any) bool","position":{"file":"context.go","line":325},"examples":[]},{"name":"GetDuration","doc":"GetDuration returns the value associated with the key as a duration.","docMarkdown":"GetDuration returns the value associated with the key as a duration.","signature":"func (c *Context) GetDuration(key any) time.Duration","position":{"file":"context.go","line":395},"examples":[]},{"name":"GetError","doc":"GetError returns the value associated with the key as an error.","docMarkdown":"GetError returns the value associated with the key as an error.","signature":"func (c *Context) GetError(key any) error","position":{"file":"context.go","line":400},"examples":[]},{"name":"GetErrorSlice","doc":"GetErrorSlice returns the value associated with the key as a slice of errors.","docMarkdown":"GetErrorSlice returns the value associated with the key as a slice of errors.","signature":"func (c *Context) GetErrorSlice(key any) []error","position":{"file":"context.go","line":470},"examples":[]},{"name":"GetFloat32","doc":"GetFloat32 returns the value associated with the key as a float32.","docMarkdown":"GetFloat32 returns the value associated with the key as a float32.","signature":"func (c *Context) GetFloat32(key any) float32","position":{"file":"context.go","line":380},"examples":[]},{"name":"GetFloat32Slice","doc":"GetFloat32Slice returns the value associated with the key as a slice of float32 numbers.","docMarkdown":"GetFloat32Slice returns the value associated with the key as a slice of float32 numbers.","signature":"func (c *Context) GetFloat32Slice(key any) []float32","position":{"file":"context.go","line":455},"examples":[]},{"name":"GetFloat64","doc":"GetFloat64 returns the value associated with the key as a float64.","docMarkdown":"GetFloat64 returns the value associated with the key as a float64.","signature":"func (c *Context) GetFloat64(key any) float64","position":{"file":"context.go","line":385},"examples":[]},{"name":"GetFloat64Slice","doc":"GetFloat64Slice returns the value associated with the key as a slice of float64 numbers.","docMarkdown":"GetFloat64Slice returns the value associated with the key as a slice of float64 numbers.","signature":"func (c *Context) GetFloat64Slice(key any) []float64","position":{"file":"context.go","line":460},"examples":[]},{"name":"GetHeader","doc":"GetHeader returns value from request headers.","docMarkdown":"GetHeader returns value from request headers.","signature":"func (c *Context) GetHeader(key string) string","position":{"file":"context.go","line":1138},"examples":[]},{"name":"GetInt","doc":"GetInt returns the value associated with the key as an integer.","docMarkdown":"GetInt returns the value associated with the key as an integer.","signature":"func (c *Context) GetInt(key any) int","position":{"file":"context.go","line":330},"examples":[]},{"name":"GetInt16","doc":"GetInt16 returns the value associated with the key as an integer 16.","docMarkdown":"GetInt16 returns the value associated with the key as an integer 16.","signature":"func (c *Context) GetInt16(key any) int16","position":{"file":"context.go","line":340},"examples":[]},{"name":"GetInt16Slice","doc":"GetInt16Slice returns the value associated with the key as a slice of int16 integers.","docMarkdown":"GetInt16Slice returns the value associated with the key as a slice of int16 integers.","signature":"func (c *Context) GetInt16Slice(key any) []int16","position":{"file":"context.go","line":415},"examples":[]},{"name":"GetInt32","doc":"GetInt32 returns the value associated with the key as an integer 32.","docMarkdown":"GetInt32 returns the value associated with the key as an integer 32.","signature":"func (c *Context) GetInt32(key any) int32","position":{"file":"context.go","line":345},"examples":[]},{"name":"GetInt32Slice","doc":"GetInt32Slice returns the value associated with the key as a slice of int32 integers.","docMarkdown":"GetInt32Slice returns the value associated with the key as a slice of int32 integers.","signature":"func (c *Context) GetInt32Slice(key any) []int32","position":{"file":"context.go","line":420},"examples":[]},{"name":"GetInt64","doc":"GetInt64 returns the value associated with the key as an integer 64.","docMarkdown":"GetInt64 returns the value associated with the key as an integer 64.","signature":"func (c *Context) GetInt64(key any) int64","position":{"file":"context.go","line":350},"examples":[]},{"name":"GetInt64Slice","doc":"GetInt64Slice returns the value associated with the key as a slice of int64 integers.","docMarkdown":"GetInt64Slice returns the value associated with the key as a slice of int64 integers.","signature":"func (c *Context) GetInt64Slice(key any) []int64","position":{"file":"context.go","line":425},"examples":[]},{"name":"GetInt8","doc":"GetInt8 returns the value associated with the key as an integer 8.","docMarkdown":"GetInt8 returns the value associated with the key as an integer 8.","signature":"func (c *Context) GetInt8(key any) int8","position":{"file":"context.go","line":335},"examples":[]},{"name":"GetInt8Slice","doc":"GetInt8Slice returns the value associated with the key as a slice of int8 integers.","docMarkdown":"GetInt8Slice returns the value associated with the key as a slice of int8 integers.","signature":"func (c *Context) GetInt8Slice(key any) []int8","position":{"file":"context.go","line":410},"examples":[]},{"name":"GetIntSlice","doc":"GetIntSlice returns the value associated with the key as a slice of integers.","docMarkdown":"GetIntSlice returns the value associated with the key as a slice of integers.","signature":"func (c *Context) GetIntSlice(key any) []int","position":{"file":"context.go","line":405},"examples":[]},{"name":"GetPostForm","doc":"GetPostForm is like PostForm(key). It returns the specified key from a POST urlencoded\nform or multipart form when it exists `(value, true)` (even when the value is an empty string),\notherwise it returns (\"\", false).\nFor example, during a PATCH request to update the user's email:\n\n\t    email=mail@example.com  -->  (\"mail@example.com\", true) := GetPostForm(\"email\") // set email to \"mail@example.com\"\n\t\temail=                  -->  (\"\", true) := GetPostForm(\"email\")                 // set email to \"\"\n\t                            -->  (\"\", false) := GetPostForm(\"email\")                // do nothing with email","docMarkdown":"GetPostForm is like PostForm(key). It returns the specified key from a POST urlencoded form or multipart form when it exists `(value, true)` (even when the value is an empty string), otherwise it returns (\"\", false). For example, during a PATCH request to update the user's email:\n\n\t    email=mail@example.com  -->  (\"mail@example.com\", true) := GetPostForm(\"email\") // set email to \"mail@example.com\"\n\t\temail=                  -->  (\"\", true) := GetPostForm(\"email\")                 // set email to \"\"\n\t                            -->  (\"\", false) := GetPostForm(\"email\")                // do nothing with email","signature":"func (c *Context) GetPostForm(key string) (string, bool)","position":{"file":"context.go","line":633},"examples":[]},{"name":"GetPostFormArray","doc":"GetPostFormArray returns a slice of strings for a given form key, plus\na boolean value whether at least one value exists for the given key.","docMarkdown":"GetPostFormArray returns a slice of strings for a given form key, plus a boolean value whether at least one value exists for the given key.","signature":"func (c *Context) GetPostFormArray(key string) (values []string, ok bool)","position":{"file":"context.go","line":662},"examples":[]},{"name":"GetPostFormMap","doc":"GetPostFormMap returns a map for a given form key, plus a boolean value\nwhether at least one value exists for the given key.","docMarkdown":"GetPostFormMap returns a map for a given form key, plus a boolean value whether at least one value exists for the given key.","signature":"func (c *Context) GetPostFormMap(key string) (map[string]string, bool)","position":{"file":"context.go","line":676},"examples":[]},{"name":"GetQuery","doc":"GetQuery is like Query(), it returns the keyed url query value\nif it exists `(value, true)` (even when the value is an empty string),\notherwise it returns `(\"\", false)`.\nIt is shortcut for `c.Request.URL.Query().Get(key)`\n\n\tGET /?name=Manu&lastname=\n\t(\"Manu\", true) == c.GetQuery(\"name\")\n\t(\"\", false) == c.GetQuery(\"id\")\n\t(\"\", true) == c.GetQuery(\"lastname\")","docMarkdown":"GetQuery is like Query(), it returns the keyed url query value if it exists `(value, true)` (even when the value is an empty string), otherwise it returns `(\"\", false)`. It is shortcut for `c.Request.URL.Query().Get(key)`\n\n\tGET /?name=Manu&lastname=\n\t(\"Manu\", true) == c.GetQuery(\"name\")\n\t(\"\", false) == c.GetQuery(\"id\")\n\t(\"\", true) == c.GetQuery(\"lastname\")","signature":"func (c *Context) GetQuery(key string) (string, bool)","position":{"file":"context.go","line":563},"examples":[]},{"name":"GetQueryArray","doc":"GetQueryArray returns a slice of strings for a given query key, plus\na boolean value whether at least one value exists for the given key.","docMarkdown":"GetQueryArray returns a slice of strings for a given query key, plus a boolean value whether at least one value exists for the given key.","signature":"func (c *Context) GetQueryArray(key string) (values []string, ok bool)","position":{"file":"context.go","line":589},"examples":[]},{"name":"GetQueryMap","doc":"GetQueryMap returns a map for a given query key, plus a boolean value\nwhether at least one value exists for the given key.","docMarkdown":"GetQueryMap returns a map for a given query key, plus a boolean value whether at least one value exists for the given key.","signature":"func (c *Context) GetQueryMap(key string) (map[string]string, bool)","position":{"file":"context.go","line":603},"examples":[]},{"name":"GetRawData","doc":"GetRawData returns stream data.","docMarkdown":"GetRawData returns stream data.","signature":"func (c *Context) GetRawData() ([]byte, error)","position":{"file":"context.go","line":1143},"examples":[]},{"name":"GetString","doc":"GetString returns the value associated with the key as a string.","docMarkdown":"GetString returns the value associated with the key as a string.","signature":"func (c *Context) GetString(key any) string","position":{"file":"context.go","line":320},"examples":[]},{"name":"GetStringMap","doc":"GetStringMap returns the value associated with the key as a map of interfaces.","docMarkdown":"GetStringMap returns the value associated with the key as a map of interfaces.","signature":"func (c *Context) GetStringMap(key any) map[string]any","position":{"file":"context.go","line":475},"examples":[]},{"name":"GetStringMapString","doc":"GetStringMapString returns the value associated with the key as a map of strings.","docMarkdown":"GetStringMapString returns the value associated with the key as a map of strings.","signature":"func (c *Context) GetStringMapString(key any) map[string]string","position":{"file":"context.go","line":480},"examples":[]},{"name":"GetStringMapStringSlice","doc":"GetStringMapStringSlice returns the value associated with the key as a map to a slice of strings.","docMarkdown":"GetStringMapStringSlice returns the value associated with the key as a map to a slice of strings.","signature":"func (c *Context) GetStringMapStringSlice(key any) map[string][]string","position":{"file":"context.go","line":485},"examples":[]},{"name":"GetStringSlice","doc":"GetStringSlice returns the value associated with the key as a slice of strings.","docMarkdown":"GetStringSlice returns the value associated with the key as a slice of strings.","signature":"func (c *Context) GetStringSlice(key any) []string","position":{"file":"context.go","line":465},"examples":[]},{"name":"GetTime","doc":"GetTime returns the value associated with the key as time.","docMarkdown":"GetTime returns the value associated with the key as time.","signature":"func (c *Context) GetTime(key any) time.Time","position":{"file":"context.go","line":390},"examples":[]},{"name":"GetUint","doc":"GetUint returns the value associated with the key as an unsigned integer.","docMarkdown":"GetUint returns the value associated with the key as an unsigned integer.","signature":"func (c *Context) GetUint(key any) uint","position":{"file":"context.go","line":355},"examples":[]},{"name":"GetUint16","doc":"GetUint16 returns the value associated with the key as an unsigned integer 16.","docMarkdown":"GetUint16 returns the value associated with the key as an unsigned integer 16.","signature":"func (c *Context) GetUint16(key any) uint16","position":{"file":"context.go","line":365},"examples":[]},{"name":"GetUint16Slice","doc":"GetUint16Slice returns the value associated with the key as a slice of uint16 integers.","docMarkdown":"GetUint16Slice returns the value associated with the key as a slice of uint16 integers.","signature":"func (c *Context) GetUint16Slice(key any) []uint16","position":{"file":"context.go","line":440},"examples":[]},{"name":"GetUint32","doc":"GetUint32 returns the value associated with the key as an unsigned integer 32.","docMarkdown":"GetUint32 returns the value associated with the key as an unsigned integer 32.","signature":"func (c *Context) GetUint32(key any) uint32","position":{"file":"context.go","line":370},"examples":[]},{"name":"GetUint32Slice","doc":"GetUint32Slice returns the value associated with the key as a slice of uint32 integers.","docMarkdown":"GetUint32Slice returns the value associated with the key as a slice of uint32 integers.","signature":"func (c *Context) GetUint32Slice(key any) []uint32","position":{"file":"context.go","line":445},"examples":[]},{"name":"GetUint64","doc":"GetUint64 returns the value associated with the key as an unsigned integer 64.","docMarkdown":"GetUint64 returns the value associated with the key as an unsigned integer 64.","signature":"func (c *Context) GetUint64(key any) uint64","position":{"file":"context.go","line":375},"examples":[]},{"name":"GetUint64Slice","doc":"GetUint64Slice returns the value associated with the key as a slice of uint64 integers.","docMarkdown":"GetUint64Slice returns the value associated with the key as a slice of uint64 integers.","signature":"func (c *Context) GetUint64Slice(key any) []uint64","position":{"file":"context.go","line":450},"examples":[]},{"name":"GetUint8","doc":"GetUint8 returns the value associated with the key as an unsigned integer 8.","docMarkdown":"GetUint8 returns the value associated with the key as an unsigned integer 8.","signature":"func (c *Context) GetUint8(key any) uint8","position":{"file":"context.go","line":360},"examples":[]},{"name":"GetUint8Slice","doc":"GetUint8Slice returns the value associated with the key as a slice of uint8 integers.","docMarkdown":"GetUint8Slice returns the value associated with the key as a slice of uint8 integers.","signature":"func (c *Context) GetUint8Slice(key any) []uint8","position":{"file":"context.go","line":435},"examples":[]},{"name":"GetUintSlice","doc":"GetUintSlice returns the value associated with the key as a slice of unsigned integers.","docMarkdown":"GetUintSlice returns the value associated with the key as a slice of unsigned integers.","signature":"func (c *Context) GetUintSlice(key any) []uint","position":{"file":"context.go","line":430},"examples":[]},{"name":"HTML","doc":"HTML renders the HTTP template specified by its file name.\nIt also updates the HTTP code and sets the Content-Type as \"text/html\".\nSee http://golang.org/doc/articles/wiki/","docMarkdown":"HTML renders the HTTP template specified by its file name. It also updates the HTTP code and sets the Content-Type as \"text/html\". See [http://golang.org/doc/articles/wiki/](http://golang.org/doc/articles/wiki/)","signature":"func (c *Context) HTML(code int, name string, obj any)","position":{"file":"context.go","line":1220},"examples":[]},{"name":"Handler","doc":"Handler returns the main handler.","docMarkdown":"Handler returns the main handler.","signature":"func (c *Context) Handler() HandlerFunc","position":{"file":"context.go","line":176},"examples":[]},{"name":"HandlerName","doc":"HandlerName returns the main handler's name. For example if the handler is \"handleGetUsers()\",\nthis function will return \"main.handleGetUsers\".","docMarkdown":"HandlerName returns the main handler's name. For example if the handler is \"handleGetUsers()\", this function will return \"main.handleGetUsers\".","signature":"func (c *Context) HandlerName() string","position":{"file":"context.go","line":158},"examples":[]},{"name":"HandlerNames","doc":"HandlerNames returns a list of all registered handlers for this context in descending order,\nfollowing the semantics of HandlerName()","docMarkdown":"HandlerNames returns a list of all registered handlers for this context in descending order, following the semantics of HandlerName()","signature":"func (c *Context) HandlerNames() []string","position":{"file":"context.go","line":164},"examples":[]},{"name":"Header","doc":"Header is an intelligent shortcut for c.Writer.Header().Set(key, value).\nIt writes a header in the response.\nIf value == \"\", this method removes the header `c.Writer.Header().Del(key)`","docMarkdown":"Header is an intelligent shortcut for c.Writer.Header().Set(key, value). It writes a header in the response. If value == \"\", this method removes the header `c.Writer.Header().Del(key)`","signature":"func (c *Context) Header(key, value string)","position":{"file":"context.go","line":1129},"examples":[]},{"name":"IndentedJSON","doc":"IndentedJSON serializes the given struct as pretty JSON (indented + endlines) into the response body.\nIt also sets the Content-Type as \"application/json\".\nWARNING: we recommend using this only for development purposes since printing pretty JSON is\nmore CPU and bandwidth consuming. Use Context.JSON() instead.","docMarkdown":"IndentedJSON serializes the given struct as pretty JSON (indented + endlines) into the response body. It also sets the Content-Type as \"application/json\". WARNING: we recommend using this only for development purposes since printing pretty JSON is more CPU and bandwidth consuming. Use Context.JSON() instead.","signature":"func (c *Context) IndentedJSON(code int, obj any)","position":{"file":"context.go","line":1234},"examples":[]},{"name":"IsAborted","doc":"IsAborted returns true if the current context was aborted.","docMarkdown":"IsAborted returns true if the current context was aborted.","signature":"func (c *Context) IsAborted() bool","position":{"file":"context.go","line":208},"examples":[]},{"name":"IsWebsocket","doc":"IsWebsocket returns true if the request headers indicate that a websocket\nhandshake is being initiated by the client.","docMarkdown":"IsWebsocket returns true if the request headers indicate that a websocket handshake is being initiated by the client.","signature":"func (c *Context) IsWebsocket() bool","position":{"file":"context.go","line":1064},"examples":[]},{"name":"JSON","doc":"JSON serializes the given struct as JSON into the response body.\nIt also sets the Content-Type as \"application/json\".","docMarkdown":"JSON serializes the given struct as JSON into the response body. It also sets the Content-Type as \"application/json\".","signature":"func (c *Context) JSON(code int, obj any)","position":{"file":"context.go","line":1259},"examples":[]},{"name":"JSONP","doc":"JSONP serializes the given struct as JSON into the response body.\nIt adds padding to response body to request data from a server residing in a different domain than the client.\nIt also sets the Content-Type as \"application/javascript\".","docMarkdown":"JSONP serializes the given struct as JSON into the response body. It adds padding to response body to request data from a server residing in a different domain than the client. It also sets the Content-Type as \"application/javascript\".","signature":"func (c *Context) JSONP(code int, obj any)","position":{"file":"context.go","line":1248},"examples":[]},{"name":"MultipartForm","doc":"MultipartForm is the parsed multipart form, including file uploads.","docMarkdown":"MultipartForm is the parsed multipart form, including file uploads.","signature":"func (c *Context) MultipartForm() (*multipart.Form, error)","position":{"file":"context.go","line":722},"examples":[]},{"name":"MustBindWith","doc":"MustBindWith binds the passed struct pointer using the specified binding engine.\nIt will abort the request with HTTP 400 if any error occurs.\nSee the binding package.","docMarkdown":"MustBindWith binds the passed struct pointer using the specified binding engine. It will abort the request with HTTP 400 if any error occurs. See the binding package.","signature":"func (c *Context) MustBindWith(obj any, b binding.Binding) error","position":{"file":"context.go","line":832},"examples":[]},{"name":"MustGet","doc":"MustGet returns the value for the given key if it exists, otherwise it panics.","docMarkdown":"MustGet returns the value for the given key if it exists, otherwise it panics.","signature":"func (c *Context) MustGet(key any) any","position":{"file":"context.go","line":305},"examples":[]},{"name":"Negotiate","doc":"Negotiate calls different Render according to acceptable Accept format.","docMarkdown":"Negotiate calls different Render according to acceptable Accept format.","signature":"func (c *Context) Negotiate(code int, config Negotiate)","position":{"file":"context.go","line":1418},"examples":[]},{"name":"NegotiateFormat","doc":"NegotiateFormat returns an acceptable Accept format.","docMarkdown":"NegotiateFormat returns an acceptable Accept format.","signature":"func (c *Context) NegotiateFormat(offered ...string) string","position":{"file":"context.go","line":1454},"examples":[]},{"name":"Next","doc":"Next should be used only inside middleware.\nIt executes the pending handlers in the chain inside the calling handler.\nSee example in GitHub.","docMarkdown":"Next should be used only inside middleware. It executes the pending handlers in the chain inside the calling handler. See example in GitHub.","signature":"func (c *Context) Next()","position":{"file":"context.go","line":197},"examples":[]},{"name":"PDF","doc":"PDF writes the given PDF binary data into the response body.\nIt also sets the Content-Type as \"application/pdf\".","docMarkdown":"PDF writes the given PDF binary data into the response body. It also sets the Content-Type as \"application/pdf\".","signature":"func (c *Context) PDF(code int, data []byte)","position":{"file":"context.go","line":1283},"examples":[]},{"name":"Param","doc":"Param returns the value of the URL param.\nIt is a shortcut for c.Params.ByName(key)\n\n\trouter.GET(\"/user/:id\", func(c *gin.Context) {\n\t    // a GET request to /user/john\n\t    id := c.Param(\"id\") // id == \"john\"\n\t    // a GET request to /user/john/\n\t    id := c.Param(\"id\") // id == \"/john/\"\n\t})","docMarkdown":"Param returns the value of the URL param. It is a shortcut for c.Params.ByName(key)\n\n\trouter.GET(\"/user/:id\", func(c *gin.Context) {\n\t    // a GET request to /user/john\n\t    id := c.Param(\"id\") // id == \"john\"\n\t    // a GET request to /user/john/\n\t    id := c.Param(\"id\") // id == \"/john/\"\n\t})","signature":"func (c *Context) Param(key string) string","position":{"file":"context.go","line":512},"examples":[]},{"name":"PostForm","doc":"PostForm returns the specified key 